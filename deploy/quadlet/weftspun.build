#
# Builds weftspun_studio from this repo's own Dockerfile. RFD 0120
# split this app out of weftspun-3d-studio's apps/weftspun_studio/
# into its own repo, weftspun/weftspun-studio, alongside
# weftspun/weftspun-character-taxonomy and
# weftspun/weftspun-usd-viewer. RFD 0058.

[Build]
ImageTag=localhost/weftspun:latest
File=/opt/weftspun/weftspun-studio/Dockerfile
SetWorkingDirectory=file
# See weftspun-crdb.build: rootful Podman's bridge network cannot
# reach the internet on this host. Network=host is build-time only —
# weftspun.container still runs on the isolated weftspun.network.
Network=host
DNS=1.1.1.1
